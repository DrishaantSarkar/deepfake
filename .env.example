# ==============================================================================
# TRUSTLENS Investigation Workspace - Environment Configuration
# ==============================================================================
# Copy this file to .env for local overrides. Do NOT commit .env to version control.
# Real secrets must be injected via your container orchestrator or cloud secret manager.

# Environment mode: development | staging | production
TRUSTLENS_ENV=production

# Server network binding (127.0.0.1 for local loopback; 0.0.0.0 for Docker/cloud ingress)
TRUSTLENS_HOST=0.0.0.0

# Server listening port (default: 8765; cloud hosts often supply PORT automatically)
TRUSTLENS_PORT=8765

# Allowed Host headers (comma-separated; use * or your specific domain in production)
TRUSTLENS_ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0

# Persistent SQLite database file path
# In Docker, mount a volume to /app/data to persist across container restarts
TRUSTLENS_DB_PATH=/app/data/analyses.sqlite3

# Temporary media staging directory (automatically purged upon analysis completion)
TRUSTLENS_TEMP_DIR=/app/temp

# Path to PyTorch model checkpoint (.pt)
# Default searches ./checkpoints/best_model.pt
TRUSTLENS_MODEL_PATH=/app/checkpoints/best_model.pt

# Administrator secret key for privileged API endpoints (/api/admin/verify and /api/admin/status)
# Replace with a cryptographically strong random token in production
TRUSTLENS_ADMIN_KEY=change-this-to-a-secure-random-token-in-production
